fnm alias 20.11.0 hello
fnm update 20"
`;

exports[`PowerShell --dry-run reports an update without installing it: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fnm env | Out-String | Invoke-Expression
fnm install 20.11.0
$($__out__ = $(fnm update --dry-run 20 | Select-String "update available"); if ($__out__ -eq $null) { exit 1 } else { $__out__ })"
`;

exports[`PowerShell --prune removes the superseded version: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fnm env | Out-String | Invoke-Expression
fnm install 20.11.0
fnm update --prune 20"
`;

