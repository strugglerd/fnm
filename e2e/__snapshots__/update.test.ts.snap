// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Bash --dry-run reports an update without installing it: Bash 1`] = `
"set -e
eval "$(fnm env)"
fnm install 20.11.0
(fnm update --dry-run 20) | grep "update available" || (echo "Expected output to contain "update available"" && exit 1)"
`;

exports[`Bash --prune removes the superseded version: Bash 1`] = `
"set -e
eval "$(fnm env)"
fnm install 20.11.0
fnm update --prune 20"
`;

exports[`Bash moves aliases to the updated version and keeps the old one: Bash 1`] = `
"set -e
eval "$(fnm env)"
fnm install 20.11.0
fnm alias 20.11.0 hello
fnm update 20"
`;

exports[`Fish --dry-run reports an update without installing it: Fish 1`] = `
"fnm env | source
fnm install 20.11.0
begin; fnm update --dry-run 20; end | grep "update available"; or echo "Expected output to contain "update available"" && exit 1"
`;

exports[`Fish --prune removes the superseded version: Fish 1`] = `
"fnm env | source
fnm install 20.11.0
fnm update --prune 20"
`;

exports[`Fish moves aliases to the updated version and keeps the old one: Fish 1`] = `
